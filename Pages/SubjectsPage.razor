@page "/subjects"
@inject StudyStateService State
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Subjects & Study Materials | Studbud</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-white dark:bg-[#121520] p-5 sm:p-6 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Subjects & Course Material</h1>
                <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase rounded-md bg-indigo-100 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/40">
                    @State.Subjects.Count Courses • @State.SubjectNotes.Count Notes
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-[#949BAF]">Organize lecture notes, step-by-step algorithms, cheatsheets, and subject study tasks.</p>
        </div>

        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <button class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-[#181C2B] text-slate-700 dark:text-zinc-200 hover:bg-slate-200 dark:hover:bg-[#1F253A] font-semibold text-xs border border-slate-200/60 dark:border-[#1E2337] transition-all flex items-center gap-1.5"
                    @onclick="OpenCreateSubjectModal">
                <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>New Subject</span>
            </button>

            <button class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center gap-2"
                    @onclick="() => OpenCreateNoteModal(selectedSubjectId)">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <span>Write Note</span>
            </button>
        </div>
    </div>

    <!-- Main Subject Workspace Layout (Sidebar + Content Area) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Sidebar: Subject List (4 cols on lg) -->
        <div class="lg:col-span-4 space-y-3">
            <div class="bg-white dark:bg-[#121520] p-4 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm">
                <div class="flex items-center justify-between mb-3 px-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#949BAF]">Course Library</span>
                    <button class="text-xs text-indigo-600 dark:text-indigo-400 font-semibold hover:underline" @onclick="OpenCreateSubjectModal">
                        + Add
                    </button>
                </div>

                <!-- Global 'All Subjects' Button -->
                <button class="w-full text-left p-3 rounded-xl mb-2 transition-all flex items-center justify-between border @(selectedSubjectId == "ALL" ? "bg-indigo-50/80 dark:bg-indigo-950/40 border-indigo-500 text-slate-900 dark:text-white shadow-sm" : "bg-slate-50/50 dark:bg-[#161928]/60 border-slate-200/60 dark:border-[#1E2337] text-slate-600 dark:text-[#949BAF] hover:bg-slate-100 dark:hover:bg-[#1A1F30]")"
                        @onclick='() => selectedSubjectId = "ALL"'>
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-xs">
                            ★
                        </div>
                        <div>
                            <div class="text-xs font-bold">All Notes & Subjects</div>
                            <div class="text-[10px] text-slate-400">Global collection</div>
                        </div>
                    </div>
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-slate-200/70 dark:bg-[#1E2337] text-slate-700 dark:text-zinc-300">
                        @State.SubjectNotes.Count
                    </span>
                </button>

                <!-- Subject Cards List -->
                <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                    @foreach (var sub in State.Subjects)
                    {
                        var isSelected = selectedSubjectId == sub.Id;
                        var noteCount = State.SubjectNotes.Count(n => n.SubjectId == sub.Id || n.SubjectName == sub.Name);
                        var taskCount = State.Tasks.Count(t => t.Subject == sub.Name && !t.IsCompleted);

                        <div class="group relative rounded-xl border transition-all p-3 cursor-pointer @(isSelected ? "bg-indigo-50/80 dark:bg-indigo-950/40 border-indigo-500 shadow-sm" : "bg-slate-50/50 dark:bg-[#161928]/60 border-slate-200/60 dark:border-[#1E2337] hover:border-slate-300 dark:hover:border-[#2E3654]")"
                             @onclick="() => SelectSubject(sub.Id)">
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex items-start gap-2.5 flex-1 min-w-0">
                                    <!-- Color Indicator Pill -->
                                    <span class="w-3 h-3 rounded-full mt-0.5 shrink-0 shadow-sm" style="background-color: @sub.Color;"></span>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span class="text-xs font-bold text-slate-900 dark:text-white truncate">@sub.Name</span>
                                            @if (!string.IsNullOrEmpty(sub.Code))
                                            {
                                                <span class="text-[10px] font-mono font-semibold px-1.5 py-0.2 rounded bg-slate-200/70 dark:bg-[#1E2337] text-slate-600 dark:text-zinc-400">
                                                    @sub.Code
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(sub.Description))
                                        {
                                            <p class="text-[11px] text-slate-500 dark:text-[#949BAF] truncate mt-0.5">@sub.Description</p>
                                        }
                                    </div>
                                </div>

                                <!-- Count Badge & Action Menu -->
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-[#1E2337] text-slate-600 dark:text-zinc-400 font-medium" title="@noteCount notes">
                                        📝 @noteCount
                                    </span>
                                    <button class="opacity-0 group-hover:opacity-100 p-1 text-slate-400 hover:text-indigo-500 transition-opacity" 
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenEditSubjectModal(sub)"
                                            title="Edit Subject">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Content Area: Subject Workspace & Notes (8 cols on lg) -->
        <div class="lg:col-span-8 space-y-5">
            
            <!-- Active Subject Banner & Details -->
            @if (CurrentSubject != null)
            {
                <div class="p-5 rounded-2xl bg-white dark:bg-[#121520] border border-slate-200/80 dark:border-[#1E2337] shadow-sm relative overflow-hidden">
                    <!-- Color Ambient Glow -->
                    <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full blur-3xl opacity-15 pointer-events-none" style="background-color: @CurrentSubject.Color;"></div>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="w-3.5 h-3.5 rounded-full shadow-sm" style="background-color: @CurrentSubject.Color;"></span>
                                <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white">@CurrentSubject.Name</h2>
                                @if (!string.IsNullOrEmpty(CurrentSubject.Code))
                                {
                                    <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-lg bg-indigo-100 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/50">
                                        @CurrentSubject.Code
                                    </span>
                                }
                            </div>
                            <p class="text-xs text-slate-500 dark:text-[#949BAF]">
                                @(string.IsNullOrEmpty(CurrentSubject.Description) ? "Coursework, notes, and study guides." : CurrentSubject.Description)
                            </p>
                            @if (!string.IsNullOrEmpty(CurrentSubject.Instructor) || !string.IsNullOrEmpty(CurrentSubject.Schedule))
                            {
                                <div class="flex items-center gap-3 text-[11px] text-slate-400 font-mono pt-1">
                                    @if (!string.IsNullOrEmpty(CurrentSubject.Instructor))
                                    {
                                        <span>👨‍🏫 @CurrentSubject.Instructor</span>
                                    }
                                    @if (!string.IsNullOrEmpty(CurrentSubject.Schedule))
                                    {
                                        <span>🕒 @CurrentSubject.Schedule</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Quick Action Buttons -->
                        <div class="flex items-center gap-2 shrink-0">
                            <button class="px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-semibold flex items-center gap-1.5 transition-all"
                                    @onclick="() => StartSubjectFocusSession(CurrentSubject.Name)"
                                    title="Start Pomodoro Focus Session for this subject">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                <span>Focus Now</span>
                            </button>

                            <button class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-[#181C2B] border border-slate-200/60 dark:border-[#1E2337]"
                                    @onclick="() => OpenEditSubjectModal(CurrentSubject)"
                                    title="Edit Subject Details">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            </button>

                            <button class="p-2 rounded-xl text-rose-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 bg-slate-100 dark:bg-[#181C2B] border border-slate-200/60 dark:border-[#1E2337]"
                                    @onclick="() => ConfirmDeleteSubject(CurrentSubject)"
                                    title="Delete Subject">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Subject Sub-Tabs (Notes, Tasks, Resources) -->
                    <div class="flex items-center gap-2 border-t border-slate-100 dark:border-[#1E2337] mt-4 pt-3">
                        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(activeSubjectTab == "notes" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 dark:text-[#949BAF] hover:bg-slate-100 dark:hover:bg-[#181C2B]")"
                                @onclick='() => activeSubjectTab = "notes"'>
                            📝 Notes & Guides (@CurrentSubjectNotes.Count)
                        </button>
                        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(activeSubjectTab == "tasks" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 dark:text-[#949BAF] hover:bg-slate-100 dark:hover:bg-[#181C2B]")"
                                @onclick='() => activeSubjectTab = "tasks"'>
                            ✅ Linked Tasks (@CurrentSubjectTasks.Count)
                        </button>
                        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all @(activeSubjectTab == "resources" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 dark:text-[#949BAF] hover:bg-slate-100 dark:hover:bg-[#181C2B]")"
                                @onclick='() => activeSubjectTab = "resources"'>
                            📎 Cheatsheets & Links (@CurrentSubjectResources.Count)
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Global / All Subjects Banner -->
                <div class="p-5 rounded-2xl bg-white dark:bg-[#121520] border border-slate-200/80 dark:border-[#1E2337] shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">All Course Notes & Study Material</h2>
                            <p class="text-xs text-slate-500 dark:text-[#949BAF]">Viewing all notes across all subjects.</p>
                        </div>
                        <button class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-sm transition-all"
                                @onclick="() => OpenCreateNoteModal(null)">
                            + Write New Note
                        </button>
                    </div>
                </div>
            }

            <!-- TAB 1: NOTES LISTING & SEARCH -->
            @if (activeSubjectTab == "notes" || selectedSubjectId == "ALL")
            {
                <!-- Search & Topic Filter -->
                <div class="bg-white dark:bg-[#121520] p-3.5 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="relative flex-1 w-full">
                        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-[#949BAF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" 
                               class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                               placeholder="Search notes by title, topic (e.g. Clustering, NFA to DFA), or content..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>

                    @if (AvailableTopics.Any())
                    {
                        <select class="text-xs py-1.5 px-3 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-700 dark:text-[#EDEDED] focus:outline-none focus:ring-1 focus:ring-indigo-500 shrink-0 w-full sm:w-auto"
                                @bind="selectedTopicFilter">
                            <option value="All">All Topics</option>
                            @foreach (var topic in AvailableTopics)
                            {
                                <option value="@topic">@topic</option>
                            }
                        </select>
                    }
                </div>

                <!-- Notes Cards Grid -->
                @if (!FilteredNotes.Any())
                {
                    <div class="bg-white dark:bg-[#121520] p-8 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] text-center">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-500 mx-auto flex items-center justify-center mb-3">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </div>
                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">No Notes Found</h4>
                        <p class="text-xs text-slate-500 dark:text-[#949BAF] max-w-sm mx-auto mt-1 mb-4">
                            @(string.IsNullOrEmpty(searchQuery) ? "Start adding lecture notes, algorithms, or study formulas to this subject!" : "No notes match your search keywords.")
                        </p>
                        <button class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition-all"
                                @onclick="() => OpenCreateNoteModal(selectedSubjectId)">
                            + Write First Note
                        </button>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var note in FilteredNotes)
                        {
                            var subDef = State.Subjects.FirstOrDefault(s => s.Id == note.SubjectId || s.Name == note.SubjectName);
                            var accentColor = subDef?.Color ?? "#6366F1";

                            <div class="bg-white dark:bg-[#121520] rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm hover:border-slate-300 dark:hover:border-[#2E3654] transition-all p-5 flex flex-col justify-between group">
                                <div>
                                    <!-- Top Row: Subject Pill, Topic Tag, Pin Button -->
                                    <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-semibold" style="background-color: @(accentColor)15; color: @accentColor; border: 1px solid @(accentColor)30;">
                                                <span class="w-1.5 h-1.5 rounded-full" style="background-color: @accentColor;"></span>
                                                @note.SubjectName
                                            </span>

                                            @if (!string.IsNullOrEmpty(note.Topic))
                                            {
                                                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-[#1A1F30] text-slate-600 dark:text-zinc-300 text-[11px] font-medium border border-slate-200/60 dark:border-[#1E2337]">
                                                    📌 @note.Topic
                                                </span>
                                            }
                                        </div>

                                        <div class="flex items-center gap-1">
                                            <button class="p-1 rounded-lg transition-colors @(note.IsPinned ? "text-amber-500 bg-amber-50 dark:bg-amber-950/40" : "text-slate-400 hover:text-slate-700 dark:hover:text-white")"
                                                    @onclick="() => State.TogglePinNoteAsync(note.Id)"
                                                    title="@(note.IsPinned ? "Unpin Note" : "Pin Note to Top")">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="@(note.IsPinned ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
                                                    <line x1="12" y1="17" x2="12" y2="22"></line>
                                                    <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.89A2 2 0 0 1 15 10.76V6h1a1 1 0 0 0 0-2H8a1 1 0 0 0 0 2h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.89A2 2 0 0 0 5 15.24Z"></path>
                                                </svg>
                                            </button>

                                            <button class="p-1 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                                                    @onclick="() => OpenEditNoteModal(note)"
                                                    title="Edit Note">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                            </button>

                                            <button class="p-1 text-slate-400 hover:text-rose-500 transition-colors"
                                                    @onclick="() => State.DeleteSubjectNoteAsync(note.Id)"
                                                    title="Delete Note">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Note Title -->
                                    <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mb-2 cursor-pointer hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                                        @onclick="() => OpenReaderModal(note)">
                                        @note.Title
                                    </h3>

                                    <!-- Note Preview Formatted Content (Truncated cleanly) -->
                                    <div class="max-h-36 overflow-hidden relative cursor-pointer mask-fade" @onclick="() => OpenReaderModal(note)">
                                        <FormattedNoteView Content="@GetPreviewSnippet(note.Content)" />
                                    </div>
                                </div>

                                <!-- Footer: Tags, Date, and Read More -->
                                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-[#1E2337] flex items-center justify-between gap-2 flex-wrap text-xs">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        @if (!string.IsNullOrEmpty(note.Tags))
                                        {
                                            @foreach (var tag in note.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-[#181C2B] text-slate-500 dark:text-[#949BAF]">
                                                    #@tag
                                                </span>
                                            }
                                        }
                                        <span class="text-[11px] text-slate-400">
                                            Updated @note.UpdatedAt.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        <button class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-[#181C2B] hover:bg-slate-200 dark:hover:bg-[#20263c] text-slate-700 dark:text-zinc-200 text-[11px] font-medium transition-colors"
                                                @onclick="() => CopyNoteContent(note)">
                                            📋 Copy
                                        </button>
                                        <button class="px-3 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 text-indigo-600 dark:text-indigo-400 font-semibold text-[11px] transition-colors"
                                                @onclick="() => OpenReaderModal(note)">
                                            Read Full Note →
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 2: LINKED TASKS -->
            @if (activeSubjectTab == "tasks" && CurrentSubject != null)
            {
                <div class="bg-white dark:bg-[#121520] p-5 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Tasks for @CurrentSubject.Name</h3>
                        <span class="text-xs text-slate-400">@CurrentSubjectTasks.Count(t => t.IsCompleted) / @CurrentSubjectTasks.Count done</span>
                    </div>

                    <!-- Quick Add Task for this subject -->
                    <div class="flex items-center gap-2">
                        <input type="text"
                               class="flex-1 px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                               placeholder="Add a new deliverable/task for @CurrentSubject.Name... (Press Enter)"
                               @bind="newQuickTaskTitle"
                               @onkeydown="HandleQuickTaskKeyDown" />
                        <button class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shrink-0 transition-all disabled:opacity-40"
                                @onclick="AddQuickTaskForSubject"
                                disabled="@string.IsNullOrWhiteSpace(newQuickTaskTitle)">
                            + Add Task
                        </button>
                    </div>

                    <!-- Tasks List -->
                    @if (!CurrentSubjectTasks.Any())
                    {
                        <div class="p-6 text-center text-xs text-slate-400">
                            No tasks scheduled for @CurrentSubject.Name. Type a task above to schedule coursework!
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var task in CurrentSubjectTasks)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/60 dark:border-[#1E2337] gap-3">
                                    <div class="flex items-center gap-2.5 flex-1 min-w-0">
                                        <input type="checkbox" 
                                               checked="@task.IsCompleted" 
                                               class="w-4 h-4 text-indigo-600 accent-indigo-600 cursor-pointer rounded shrink-0" 
                                               @onchange="() => State.ToggleTaskCompletionAsync(task.Id)" />
                                        <span class="text-xs font-medium truncate @(task.IsCompleted ? "line-through text-slate-400" : "text-slate-900 dark:text-white")">
                                            @task.Title
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200/70 dark:bg-[#1E2337] text-slate-600 dark:text-zinc-400">
                                            🍅 @task.CompletedPomodoros/@task.EstimatedPomodoros
                                        </span>
                                        <button class="text-slate-400 hover:text-rose-500 text-xs p-1" @onclick="() => State.DeleteTaskAsync(task.Id)">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- TAB 3: CHEATSHEETS & RESOURCES -->
            @if (activeSubjectTab == "resources" && CurrentSubject != null)
            {
                <div class="bg-white dark:bg-[#121520] p-5 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Cheatsheets, Formulas & References</h3>
                            <p class="text-xs text-slate-400">Quick references and links for @CurrentSubject.Name.</p>
                        </div>
                        <button class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-sm transition-all"
                                @onclick="() => showAddResourceModal = true">
                            + Add Resource
                        </button>
                    </div>

                    @if (!CurrentSubjectResources.Any())
                    {
                        <div class="p-8 text-center text-xs text-slate-400 border border-dashed border-slate-200 dark:border-[#1E2337] rounded-xl">
                            No external links or cheat references added yet. Add textbook links, syllabus links, or formula sheets!
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            @foreach (var res in CurrentSubjectResources)
                            {
                                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/60 dark:border-[#1E2337] flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 block mb-0.5">
                                            @res.Type
                                        </span>
                                        <div class="text-xs font-bold text-slate-900 dark:text-white truncate">@res.Title</div>
                                        <p class="text-[11px] font-mono text-slate-400 truncate mt-0.5">@res.UrlOrReference</p>
                                    </div>
                                    <button class="text-slate-400 hover:text-rose-500 p-1 shrink-0" @onclick="() => State.DeleteSubjectResourceAsync(res.Id)">
                                        ✕
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. WRITE / EDIT NOTE MODAL                 -->
<!-- ========================================== -->
@if (showNoteEditorModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white dark:bg-[#121520] rounded-3xl border border-slate-200 dark:border-[#1E2337] shadow-2xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden">
            <!-- Modal Header -->
            <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-[#1E2337] flex items-center justify-between">
                <div>
                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-white">
                        @(isEditingNote ? "Edit Study Note" : "Write New Subject Note")
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-[#949BAF]">Add markdown-formatted notes, step-by-step algorithms, or cheat sheets.</p>
                </div>
                <button class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#1A1F30]"
                        @onclick="() => showNoteEditorModal = false">
                    ✕
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-1">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Subject / Course *</label>
                        <select class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500"
                                @bind="noteFormSubjectId">
                            @foreach (var sub in State.Subjects)
                            {
                                <option value="@sub.Id">@sub.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Topic / Unit (e.g. Clustering, NFA to DFA)</label>
                        <input type="text"
                               class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500"
                               placeholder="e.g. Clustering & K-Means"
                               @bind="noteFormTopic" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Note Title *</label>
                    <input type="text"
                           class="w-full px-3 py-2 text-xs font-bold rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500"
                           placeholder="e.g. K-Means Algorithm & Silhouette Score Guide"
                           @bind="noteFormTitle" />
                </div>

                <!-- Markdown Formatting Toolbar -->
                <div>
                    <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF]">Content / Body (Markdown supported)</label>
                        <div class="flex items-center gap-1">
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("### Heading\n")'>H3</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("**bold text**")'>B</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("- Bullet point\n")'>• List</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("1. Step one\n")'>1. Step</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("$$ \\text{Formula} $$")'>$$ Math</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("```\n// Code or table\n```\n")'>&lt;/&gt; Code</button>
                            <button type="button" class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-slate-300 hover:bg-slate-200" @onclick='() => InsertFormatting("> Key reminder / callout note\n")'>&gt; Note</button>
                        </div>
                    </div>
                    <textarea rows="10"
                              class="w-full p-3 text-xs font-mono rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500 leading-relaxed"
                              placeholder="Write detailed notes, formulas, step-by-step algorithms, or lecture summaries..."
                              @bind="noteFormContent"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Tags (comma separated)</label>
                        <input type="text"
                               class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white"
                               placeholder="e.g. Clustering, Exam, Theory"
                               @bind="noteFormTags" />
                    </div>

                    <div class="flex items-center gap-2 pt-4">
                        <input type="checkbox" id="pinCheck" class="w-4 h-4 text-indigo-600 accent-indigo-600 cursor-pointer rounded" @bind="noteFormIsPinned" />
                        <label for="pinCheck" class="text-xs font-semibold text-slate-700 dark:text-zinc-200 cursor-pointer">Pin this note to the top</label>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-slate-50 dark:bg-[#161928] border-t border-slate-100 dark:border-[#1E2337] flex items-center justify-end gap-3">
                <button class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-[#949BAF] hover:text-slate-900 dark:hover:text-white"
                        @onclick="() => showNoteEditorModal = false">
                    Cancel
                </button>
                <button class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition-all disabled:opacity-40"
                        @onclick="SaveNoteAsync"
                        disabled="@(string.IsNullOrWhiteSpace(noteFormTitle) || string.IsNullOrWhiteSpace(noteFormContent))">
                    @(isEditingNote ? "Save Changes" : "Create Note")
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 2. FULL NOTE READER MODAL                  -->
<!-- ========================================== -->
@if (showNoteReaderModal && activeReadingNote != null)
{
    var sub = State.Subjects.FirstOrDefault(s => s.Id == activeReadingNote.SubjectId || s.Name == activeReadingNote.SubjectName);
    var subColor = sub?.Color ?? "#6366F1";

    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-md animate-fade-in">
        <div class="bg-white dark:bg-[#121520] rounded-3xl border border-slate-200 dark:border-[#1E2337] shadow-2xl max-w-3xl w-full max-h-[92vh] flex flex-col overflow-hidden">
            <!-- Modal Header -->
            <div class="p-6 border-b border-slate-100 dark:border-[#1E2337] flex items-start justify-between gap-4">
                <div class="space-y-1.5 flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs font-semibold" style="background-color: @(subColor)15; color: @subColor; border: 1px solid @(subColor)30;">
                            <span class="w-1.5 h-1.5 rounded-full" style="background-color: @subColor;"></span>
                            @activeReadingNote.SubjectName
                        </span>
                        @if (!string.IsNullOrEmpty(activeReadingNote.Topic))
                        {
                            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-[#1A1F30] text-slate-700 dark:text-zinc-300 text-xs font-medium">
                                📌 @activeReadingNote.Topic
                            </span>
                        }
                        @if (activeReadingNote.IsPinned)
                        {
                            <span class="px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 text-xs font-semibold">
                                ★ Pinned
                            </span>
                        }
                    </div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                        @activeReadingNote.Title
                    </h2>
                    <div class="text-[11px] text-slate-400">
                        Created @activeReadingNote.CreatedAt.ToString("MMM dd, yyyy") • Last updated @activeReadingNote.UpdatedAt.ToString("MMM dd, yyyy h:mm tt")
                    </div>
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                    <button class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#181C2B]"
                            @onclick="() => CopyNoteContent(activeReadingNote)"
                            title="Copy Note Text">
                        📋
                    </button>
                    <button class="p-2 rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-[#181C2B]"
                            @onclick="() => { showNoteReaderModal = false; OpenEditNoteModal(activeReadingNote); }"
                            title="Edit Note">
                        ✏️
                    </button>
                    <button class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#181C2B]"
                            @onclick="() => showNoteReaderModal = false">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Modal Content (Formatted Markdown) -->
            <div class="p-6 sm:p-8 overflow-y-auto flex-1 bg-slate-50/40 dark:bg-[#0E1019]/40">
                <FormattedNoteView Content="@activeReadingNote.Content" />
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-white dark:bg-[#121520] border-t border-slate-100 dark:border-[#1E2337] flex items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-1.5 flex-wrap">
                    @if (!string.IsNullOrEmpty(activeReadingNote.Tags))
                    {
                        @foreach (var tag in activeReadingNote.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-[#181C2B] text-slate-600 dark:text-zinc-400">
                                #@tag
                            </span>
                        }
                    }
                </div>
                <button class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-[#181C2B] text-slate-700 dark:text-zinc-200 font-semibold text-xs hover:bg-slate-200 dark:hover:bg-[#1F253A]"
                        @onclick="() => showNoteReaderModal = false">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 3. SUBJECT CREATE / EDIT MODAL             -->
<!-- ========================================== -->
@if (showSubjectModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white dark:bg-[#121520] rounded-3xl border border-slate-200 dark:border-[#1E2337] shadow-2xl max-w-md w-full p-6 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-[#1E2337]">
                <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
                    @(isEditingSubject ? "Edit Subject Course" : "Add New Subject Course")
                </h3>
                <button class="text-slate-400 hover:text-white" @onclick="() => showSubjectModal = false">✕</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Subject Name *</label>
                    <input type="text" 
                           class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500" 
                           placeholder="e.g. Distributed Computing" 
                           @bind="subjectFormName" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Course Code</label>
                        <input type="text" 
                               class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500" 
                               placeholder="e.g. CS-402" 
                               @bind="subjectFormCode" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Color Theme</label>
                        <div class="flex items-center gap-2">
                            <input type="color" 
                                   class="w-8 h-8 rounded-lg cursor-pointer bg-transparent border-0 p-0" 
                                   @bind="subjectFormColor" />
                            <span class="text-xs font-mono text-slate-500">@subjectFormColor</span>
                        </div>
                    </div>
                </div>

                <!-- Preset Color Palette Swatches -->
                <div>
                    <label class="block text-[11px] font-semibold text-slate-500 mb-1.5">Preset Palettes</label>
                    <div class="flex items-center gap-2 flex-wrap">
                        @foreach (var c in PaletteColors)
                        {
                            <button type="button" 
                                    class="w-6 h-6 rounded-full border-2 transition-transform hover:scale-110 @(subjectFormColor == c ? "border-white ring-2 ring-indigo-500 scale-110" : "border-transparent")" 
                                    style="background-color: @c;" 
                                    @onclick="() => subjectFormColor = c"></button>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Instructor / Professor</label>
                    <input type="text" 
                           class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500" 
                           placeholder="e.g. Prof. Smith" 
                           @bind="subjectFormInstructor" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Schedule / Room</label>
                    <input type="text" 
                           class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500" 
                           placeholder="e.g. Tue/Thu 10:00 AM, Rm 302" 
                           @bind="subjectFormSchedule" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Description</label>
                    <textarea rows="2" 
                              class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-1 focus:ring-indigo-500" 
                              placeholder="Topics, curriculum, syllabus highlights..." 
                              @bind="subjectFormDescription"></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-[#1E2337]">
                <button class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-[#949BAF]" @onclick="() => showSubjectModal = false">
                    Cancel
                </button>
                <button class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition-all disabled:opacity-40"
                        @onclick="SaveSubjectAsync"
                        disabled="@string.IsNullOrWhiteSpace(subjectFormName)">
                    @(isEditingSubject ? "Save Changes" : "Create Subject")
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 4. ADD RESOURCE MODAL                      -->
<!-- ========================================== -->
@if (showAddResourceModal && CurrentSubject != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white dark:bg-[#121520] rounded-3xl border border-slate-200 dark:border-[#1E2337] shadow-2xl max-w-md w-full p-6 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-[#1E2337]">
                <h3 class="text-base font-extrabold text-slate-900 dark:text-white">Add Cheatsheet / Reference</h3>
                <button class="text-slate-400 hover:text-white" @onclick="() => showAddResourceModal = false">✕</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Resource Title *</label>
                    <input type="text" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" placeholder="e.g. Pumping Lemma Proof Templates" @bind="resFormTitle" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">Type</label>
                    <select class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" @bind="resFormType">
                        <option value="Cheatsheet">Cheatsheet</option>
                        <option value="Formula / Math">Formula / Math</option>
                        <option value="Web Link">Web Link</option>
                        <option value="Textbook / PDF">Textbook / PDF</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#949BAF] mb-1">URL or Reference Snippet *</label>
                    <input type="text" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" placeholder="e.g. https://... or Chapter 4 Theorem 2" @bind="resFormUrl" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-[#1E2337]">
                <button class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-[#949BAF]" @onclick="() => showAddResourceModal = false">Cancel</button>
                <button class="px-5 py-2 rounded-xl bg-indigo-600 text-white font-semibold text-xs disabled:opacity-40" @onclick="SaveResourceAsync" disabled="@string.IsNullOrWhiteSpace(resFormTitle)">Add Resource</button>
            </div>
        </div>
    </div>
}

@code {
    private string selectedSubjectId = "sub-appliedai";
    private string activeSubjectTab = "notes";
    private string searchQuery = "";
    private string selectedTopicFilter = "All";
    private string newQuickTaskTitle = "";

    // Modals state
    private bool showNoteEditorModal = false;
    private bool isEditingNote = false;
    private string editingNoteId = "";
    private string noteFormSubjectId = "";
    private string noteFormTitle = "";
    private string noteFormTopic = "";
    private string noteFormContent = "";
    private string noteFormTags = "";
    private bool noteFormIsPinned = false;

    private bool showNoteReaderModal = false;
    private SubjectNoteItem? activeReadingNote = null;

    private bool showSubjectModal = false;
    private bool isEditingSubject = false;
    private string editingSubjectId = "";
    private string subjectFormName = "";
    private string subjectFormColor = "#6366F1";
    private string subjectFormCode = "";
    private string subjectFormInstructor = "";
    private string subjectFormSchedule = "";
    private string subjectFormDescription = "";

    private bool showAddResourceModal = false;
    private string resFormTitle = "";
    private string resFormType = "Cheatsheet";
    private string resFormUrl = "";

    private readonly string[] PaletteColors = new[]
    {
        "#6366F1", "#3B82F6", "#10B981", "#EC4899", "#F59E0B", "#8B5CF6", "#06B6D4", "#EF4444", "#14B8A6"
    };

    private SubjectDef? CurrentSubject => State.Subjects.FirstOrDefault(s => s.Id == selectedSubjectId);

    private List<SubjectNoteItem> CurrentSubjectNotes => selectedSubjectId == "ALL"
        ? State.SubjectNotes
        : State.SubjectNotes.Where(n => n.SubjectId == selectedSubjectId || (CurrentSubject != null && n.SubjectName == CurrentSubject.Name)).ToList();

    private List<TaskItem> CurrentSubjectTasks => CurrentSubject == null
        ? new()
        : State.Tasks.Where(t => t.Subject == CurrentSubject.Name).ToList();

    private List<SubjectResourceItem> CurrentSubjectResources => CurrentSubject == null
        ? new()
        : State.SubjectResources.Where(r => r.SubjectId == CurrentSubject.Id).ToList();

    private IEnumerable<string> AvailableTopics => CurrentSubjectNotes
        .Select(n => n.Topic)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct();

    private IEnumerable<SubjectNoteItem> FilteredNotes
    {
        get
        {
            var list = CurrentSubjectNotes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLowerInvariant();
                list = list.Where(n =>
                    (n.Title != null && n.Title.ToLowerInvariant().Contains(q)) ||
                    (n.Topic != null && n.Topic.ToLowerInvariant().Contains(q)) ||
                    (n.Content != null && n.Content.ToLowerInvariant().Contains(q)) ||
                    (n.Tags != null && n.Tags.ToLowerInvariant().Contains(q)) ||
                    (n.SubjectName != null && n.SubjectName.ToLowerInvariant().Contains(q)));
            }

            if (selectedTopicFilter != "All")
            {
                list = list.Where(n => n.Topic == selectedTopicFilter);
            }

            // Pinned first, then newest updated
            return list.OrderByDescending(n => n.IsPinned).ThenByDescending(n => n.UpdatedAt);
        }
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;

        // Default to first subject if default id not found
        if (State.Subjects.Any() && !State.Subjects.Any(s => s.Id == selectedSubjectId))
        {
            selectedSubjectId = State.Subjects.First().Id;
        }
    }

    private void SelectSubject(string subjectId)
    {
        selectedSubjectId = subjectId;
        selectedTopicFilter = "All";
        searchQuery = "";
    }

    private void InsertFormatting(string snippet)
    {
        noteFormContent += snippet;
    }

    private string GetPreviewSnippet(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var lines = content.Split('\n').Take(6);
        return string.Join("\n", lines);
    }

    private void OpenCreateNoteModal(string? preselectedSubjectId)
    {
        isEditingNote = false;
        editingNoteId = "";
        noteFormSubjectId = !string.IsNullOrEmpty(preselectedSubjectId) && preselectedSubjectId != "ALL" 
            ? preselectedSubjectId 
            : (State.Subjects.FirstOrDefault()?.Id ?? "");
        noteFormTitle = "";
        noteFormTopic = "";
        noteFormContent = "";
        noteFormTags = "";
        noteFormIsPinned = false;
        showNoteEditorModal = true;
    }

    private void OpenEditNoteModal(SubjectNoteItem note)
    {
        isEditingNote = true;
        editingNoteId = note.Id;
        noteFormSubjectId = note.SubjectId;
        noteFormTitle = note.Title;
        noteFormTopic = note.Topic;
        noteFormContent = note.Content;
        noteFormTags = note.Tags;
        noteFormIsPinned = note.IsPinned;
        showNoteEditorModal = true;
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(noteFormTitle) || string.IsNullOrWhiteSpace(noteFormContent)) return;

        if (isEditingNote)
        {
            var note = State.SubjectNotes.FirstOrDefault(n => n.Id == editingNoteId);
            if (note != null)
            {
                note.Title = noteFormTitle;
                note.Topic = noteFormTopic;
                note.Content = noteFormContent;
                note.Tags = noteFormTags;
                note.IsPinned = noteFormIsPinned;
                note.SubjectId = noteFormSubjectId;
                await State.UpdateSubjectNoteAsync(note);
            }
        }
        else
        {
            await State.AddSubjectNoteAsync(noteFormSubjectId, noteFormTitle, noteFormTopic, noteFormContent, noteFormTags, noteFormIsPinned);
        }

        showNoteEditorModal = false;
    }

    private void OpenReaderModal(SubjectNoteItem note)
    {
        activeReadingNote = note;
        showNoteReaderModal = true;
    }

    private async Task CopyNoteContent(SubjectNoteItem note)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"# {note.Title}\nSubject: {note.SubjectName}\nTopic: {note.Topic}\n\n{note.Content}");
        }
        catch { }
    }

    private void OpenCreateSubjectModal()
    {
        isEditingSubject = false;
        editingSubjectId = "";
        subjectFormName = "";
        subjectFormColor = PaletteColors[State.Subjects.Count % PaletteColors.Length];
        subjectFormCode = "";
        subjectFormInstructor = "";
        subjectFormSchedule = "";
        subjectFormDescription = "";
        showSubjectModal = true;
    }

    private void OpenEditSubjectModal(SubjectDef sub)
    {
        isEditingSubject = true;
        editingSubjectId = sub.Id;
        subjectFormName = sub.Name;
        subjectFormColor = sub.Color;
        subjectFormCode = sub.Code;
        subjectFormInstructor = sub.Instructor;
        subjectFormSchedule = sub.Schedule;
        subjectFormDescription = sub.Description;
        showSubjectModal = true;
    }

    private async Task SaveSubjectAsync()
    {
        if (string.IsNullOrWhiteSpace(subjectFormName)) return;

        if (isEditingSubject)
        {
            var sub = State.Subjects.FirstOrDefault(s => s.Id == editingSubjectId);
            if (sub != null)
            {
                sub.Name = subjectFormName;
                sub.Color = subjectFormColor;
                sub.Code = subjectFormCode;
                sub.Instructor = subjectFormInstructor;
                sub.Schedule = subjectFormSchedule;
                sub.Description = subjectFormDescription;
                await State.UpdateSubjectAsync(sub);
            }
        }
        else
        {
            await State.AddSubjectAsync(subjectFormName, subjectFormColor, subjectFormDescription, subjectFormCode, subjectFormInstructor, subjectFormSchedule);
            var created = State.Subjects.LastOrDefault();
            if (created != null) selectedSubjectId = created.Id;
        }

        showSubjectModal = false;
    }

    private async Task ConfirmDeleteSubject(SubjectDef sub)
    {
        await State.DeleteSubjectAsync(sub.Id);
        selectedSubjectId = State.Subjects.FirstOrDefault()?.Id ?? "ALL";
    }

    private void StartSubjectFocusSession(string subjectName)
    {
        // Find or create a task for this subject, or set active task
        var existingTask = State.Tasks.FirstOrDefault(t => t.Subject == subjectName && !t.IsCompleted);
        if (existingTask != null)
        {
            State.ActiveTaskId = existingTask.Id;
        }
        Nav.NavigateTo("/");
    }

    private async Task HandleQuickTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddQuickTaskForSubject();
        }
    }

    private async Task AddQuickTaskForSubject()
    {
        if (string.IsNullOrWhiteSpace(newQuickTaskTitle) || CurrentSubject == null) return;
        await State.AddTaskAsync(newQuickTaskTitle.Trim(), CurrentSubject.Name, estimatedPomodoros: 2);
        newQuickTaskTitle = "";
    }

    private async Task SaveResourceAsync()
    {
        if (string.IsNullOrWhiteSpace(resFormTitle) || CurrentSubject == null) return;
        await State.AddSubjectResourceAsync(CurrentSubject.Id, resFormTitle, resFormUrl, resFormType);
        resFormTitle = "";
        resFormUrl = "";
        showAddResourceModal = false;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
