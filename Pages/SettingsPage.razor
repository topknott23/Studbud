@page "/settings"
@inject StudyStateService State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings & Preferences | Studbud</PageTitle>

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="bg-white dark:bg-[#121520] p-5 sm:p-6 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm">
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Workspace Preferences</h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-[#949BAF] mt-0.5">Customize Pomodoro cycle durations, audio alerts, and college courses.</p>
    </div>

    <!-- Timer Presets Section -->
    <div class="bg-white dark:bg-[#121520] p-6 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm">
        <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">Focus Mode Presets</h3>
        <p class="text-xs text-slate-500 dark:text-[#949BAF] mb-4">Choose a preset ratio or configure custom interval durations.</p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
            <div class="p-4 rounded-xl border cursor-pointer transition-all @(selectedPreset == "Classic" ? "border-indigo-500 bg-indigo-50/40 dark:bg-indigo-950/20" : "border-slate-200 dark:border-[#1E2337] hover:border-slate-300")" 
                 @onclick='() => ApplyPreset("Classic", 25, 5, 15)'>
                <div class="font-bold text-sm text-slate-900 dark:text-white">Classic Pomodoro</div>
                <div class="text-xs text-slate-500 font-mono mt-1">25m Work • 5m Short • 15m Long</div>
            </div>

            <div class="p-4 rounded-xl border cursor-pointer transition-all @(selectedPreset == "DeepWork" ? "border-indigo-500 bg-indigo-50/40 dark:bg-indigo-950/20" : "border-slate-200 dark:border-[#1E2337] hover:border-slate-300")" 
                 @onclick='() => ApplyPreset("DeepWork", 50, 10, 20)'>
                <div class="font-bold text-sm text-slate-900 dark:text-white">Deep Work Block</div>
                <div class="text-xs text-slate-500 font-mono mt-1">50m Work • 10m Short • 20m Long</div>
            </div>

            <div class="p-4 rounded-xl border cursor-pointer transition-all @(selectedPreset == "Sprint" ? "border-indigo-500 bg-indigo-50/40 dark:bg-indigo-950/20" : "border-slate-200 dark:border-[#1E2337] hover:border-slate-300")" 
                 @onclick='() => ApplyPreset("Sprint", 15, 3, 10)'>
                <div class="font-bold text-sm text-slate-900 dark:text-white">Quick Review Sprint</div>
                <div class="text-xs text-slate-500 font-mono mt-1">15m Work • 3m Short • 10m Long</div>
            </div>
        </div>

        <!-- Inputs Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-100 dark:border-[#1E2337]">
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1">Focus Time (m)</label>
                <input type="number" min="1" max="120" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" @bind="workDuration" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1">Short Break (m)</label>
                <input type="number" min="1" max="60" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" @bind="shortBreakDuration" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1">Long Break (m)</label>
                <input type="number" min="1" max="60" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" @bind="longBreakDuration" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1">Daily Target (cycles)</label>
                <input type="number" min="1" max="30" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white" @bind="dailyTarget" />
            </div>
        </div>
    </div>

    <!-- Audio & Notification Settings -->
    <div class="bg-white dark:bg-[#121520] p-6 rounded-2xl border border-slate-200/80 dark:border-[#1E2337] shadow-sm">
        <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-4">Sound & Automation</h3>

        <div class="space-y-4">
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/60 dark:border-[#1E2337]">
                <div>
                    <div class="text-xs font-bold text-slate-800 dark:text-white">Harmonic Audio Chime</div>
                    <div class="text-[11px] text-slate-400">Play pleasant synthesized chime when a focus session or break ends</div>
                </div>
                <div class="flex items-center gap-3">
                    <button class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-200 dark:bg-[#1E2337] text-slate-700 dark:text-zinc-200 hover:bg-slate-300" @onclick="TestSound">
                        Test Sound
                    </button>
                    <input type="checkbox" class="w-4 h-4 text-indigo-600 accent-indigo-600 cursor-pointer" @bind="soundEnabled" />
                </div>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/60 dark:border-[#1E2337]">
                <div>
                    <div class="text-xs font-bold text-slate-800 dark:text-white">Auto-Start Breaks</div>
                    <div class="text-[11px] text-slate-400">Automatically begin countdown timer when moving to a break</div>
                </div>
                <input type="checkbox" class="w-4 h-4 text-indigo-600 accent-indigo-600 cursor-pointer" @bind="autoStartBreaks" />
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/60 dark:border-[#1E2337]">
                <div>
                    <div class="text-xs font-bold text-slate-800 dark:text-white">Auto-Start Pomodoros</div>
                    <div class="text-[11px] text-slate-400">Automatically begin next focus block when break finishes</div>
                </div>
                <input type="checkbox" class="w-4 h-4 text-indigo-600 accent-indigo-600 cursor-pointer" @bind="autoStartPomodoros" />
            </div>
        </div>
    </div>

    <!-- Save & Reset Controls -->
    <div class="flex items-center justify-between p-4 bg-white dark:bg-[#121520] rounded-2xl border border-slate-200/80 dark:border-[#1E2337]">
        <button class="text-xs font-semibold text-rose-500 hover:text-rose-600" @onclick="ResetData">
            Reset All Workspace Data to Defaults
        </button>

        <button class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition-all" @onclick="SaveSettings">
            Save Preferences
        </button>
    </div>
</div>

@code {
    private string selectedPreset = "Classic";
    private int workDuration;
    private int shortBreakDuration;
    private int longBreakDuration;
    private int dailyTarget;
    private bool soundEnabled;
    private bool autoStartBreaks;
    private bool autoStartPomodoros;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        LoadSettings();
    }

    private void LoadSettings()
    {
        workDuration = State.Settings.WorkDurationMinutes;
        shortBreakDuration = State.Settings.ShortBreakMinutes;
        longBreakDuration = State.Settings.LongBreakMinutes;
        dailyTarget = State.Settings.DailyPomodoroGoal;
        soundEnabled = State.Settings.SoundEnabled;
        autoStartBreaks = State.Settings.AutoStartBreaks;
        autoStartPomodoros = State.Settings.AutoStartPomodoros;
    }

    private void ApplyPreset(string name, int work, int sBreak, int lBreak)
    {
        selectedPreset = name;
        workDuration = work;
        shortBreakDuration = sBreak;
        longBreakDuration = lBreak;
    }

    private async Task TestSound()
    {
        try
        {
            await JS.InvokeVoidAsync("studyApp.playChime");
        }
        catch { }
    }

    private async Task SaveSettings()
    {
        var settings = new UserSettings
        {
            WorkDurationMinutes = Math.Clamp(workDuration, 1, 120),
            ShortBreakMinutes = Math.Clamp(shortBreakDuration, 1, 60),
            LongBreakMinutes = Math.Clamp(longBreakDuration, 1, 60),
            DailyPomodoroGoal = Math.Clamp(dailyTarget, 1, 50),
            SoundEnabled = soundEnabled,
            AutoStartBreaks = autoStartBreaks,
            AutoStartPomodoros = autoStartPomodoros,
            Theme = State.Settings.Theme,
            ActivePreset = selectedPreset
        };

        await State.UpdateSettingsAsync(settings);
    }

    private async Task ResetData()
    {
        await State.ResetAllDataAsync();
        LoadSettings();
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
