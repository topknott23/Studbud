@inject StudyStateService State
@implements IDisposable

<div class="minimal-card">
    <div class="minimal-card-header">
        <span class="minimal-card-title">Tasks</span>
        <span style="font-size: 0.8rem; color: var(--text-tertiary); font-family: var(--font-mono);">
            @CompletedCount/@State.Tasks.Count done
        </span>
    </div>

    <!-- Quick Task Add Box -->
    <div class="task-quick-add">
        <input type="text" 
               class="task-quick-input" 
               placeholder="Add a new task... (press Enter)" 
               @bind="newTaskTitle" 
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />

        <div class="task-add-footer">
            <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                <select class="select-clean" @bind="selectedSubject">
                    @foreach (var sub in State.Subjects)
                    {
                        <option value="@sub.Name">@sub.Name</option>
                    }
                </select>

                <select class="select-clean" @bind="estimatedPomodoros">
                    <option value="1">1 cycle (25m)</option>
                    <option value="2">2 cycles (50m)</option>
                    <option value="3">3 cycles (75m)</option>
                    <option value="4">4 cycles (100m)</option>
                </select>
            </div>

            <button class="btn-add-minimal" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(newTaskTitle)">
                Add
            </button>
        </div>
    </div>

    <!-- Minimal Filter Tabs -->
    <div class="filter-row">
        <button class="filter-btn @(activeFilter == "All" ? "active" : "")" @onclick='() => activeFilter = "All"'>
            All (@State.Tasks.Count)
        </button>
        <button class="filter-btn @(activeFilter == "Active" ? "active" : "")" @onclick='() => activeFilter = "Active"'>
            Active (@(State.Tasks.Count - CompletedCount))
        </button>
        <button class="filter-btn @(activeFilter == "Completed" ? "active" : "")" @onclick='() => activeFilter = "Completed"'>
            Done (@CompletedCount)
        </button>
        @foreach (var sub in State.Subjects)
        {
            var count = State.Tasks.Count(t => t.Subject == sub.Name);
            if (count > 0)
            {
                <button class="filter-btn @(activeFilter == sub.Name ? "active" : "")" @onclick="() => activeFilter = sub.Name">
                    @sub.Name (@count)
                </button>
            }
        }
    </div>

    <!-- Tasks List Items -->
    <div class="task-items-container">
        @if (FilteredTasks.Any())
        {
            @foreach (var task in FilteredTasks)
            {
                var subjectDef = State.Subjects.FirstOrDefault(s => s.Name == task.Subject);
                var isFocused = State.ActiveTaskId == task.Id;

                <div class="task-row @(task.IsCompleted ? "completed" : "") @(isFocused ? "is-focus-target" : "")">
                    <div class="task-main-col">
                        <!-- Custom Minimal Checkbox -->
                        <div class="checkbox-minimal @(task.IsCompleted ? "checked" : "")" 
                             @onclick="() => ToggleTask(task.Id)"
                             title="Mark as @(task.IsCompleted ? "incomplete" : "complete")">
                            @if (task.IsCompleted)
                            {
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                        </div>

                        <!-- Task Info -->
                        <div class="task-details">
                            <span class="task-name" title="@task.Title">
                                @task.Title
                            </span>
                            <div class="task-tags">
                                <span class="subject-tag-clean">
                                    <span class="subject-dot" style="background: @(subjectDef?.Color ?? "var(--text-tertiary)");"></span>
                                    @task.Subject
                                </span>
                                <span class="cycle-tag-clean">
                                    @task.CompletedPomodoros/@task.EstimatedPomodoros cycles
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="task-row-actions">
                        @if (!task.IsCompleted)
                        {
                            <button class="btn-icon-subtle" 
                                    style="@(isFocused ? "color: var(--text-primary); font-weight: 600;" : "")"
                                    @onclick="() => SetActiveFocus(task.Id)"
                                    title="@(isFocused ? "Active in timer" : "Focus on this task")">
                                @(isFocused ? "Active" : "Focus")
                            </button>
                        }
                        <button class="btn-icon-subtle delete" 
                                @onclick="() => DeleteTask(task.Id)" 
                                title="Delete Task">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-placeholder">
                No tasks to display in this view.
            </div>
        }
    </div>
</div>

@code {
    private string newTaskTitle = "";
    private string selectedSubject = "Application Development";
    private int estimatedPomodoros = 1;
    private string activeFilter = "All";

    private int CompletedCount => State.Tasks.Count(t => t.IsCompleted);

    private IEnumerable<TaskItem> FilteredTasks
    {
        get
        {
            return activeFilter switch
            {
                "All" => State.Tasks,
                "Active" => State.Tasks.Where(t => !t.IsCompleted),
                "Completed" => State.Tasks.Where(t => t.IsCompleted),
                _ => State.Tasks.Where(t => t.Subject == activeFilter)
            };
        }
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;
        await State.AddTaskAsync(newTaskTitle, selectedSubject, estimatedPomodoros);
        newTaskTitle = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTask();
        }
    }

    private async Task ToggleTask(string id)
    {
        await State.ToggleTaskCompletionAsync(id);
    }

    private async Task DeleteTask(string id)
    {
        await State.DeleteTaskAsync(id);
    }

    private void SetActiveFocus(string id)
    {
        State.ActiveTaskId = id;
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
