@inject StudyStateService State
@implements IDisposable

<div class="minimal-card">
    <div class="minimal-card-header">
        <span class="minimal-card-title">Activity Log</span>
        @if (State.SessionHistory.Any())
        {
            <button class="btn-icon-subtle" @onclick="ClearHistory">
                Clear
            </button>
        }
    </div>

    <!-- Thin Target Progress Bar -->
    <div style="margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
            <span style="color: var(--text-secondary);">Goal Progress</span>
            <span style="color: var(--text-primary); font-family: var(--font-mono); font-weight: 500;">
                @State.CompletedPomodoroCount / @State.Settings.DailyPomodoroGoal cycles (@ProgressPercent%)
            </span>
        </div>
        <div class="target-progress-bar">
            <div class="target-progress-fill" style="width: @ProgressPercent%;"></div>
        </div>
    </div>

    <!-- Timeline List -->
    <div class="history-timeline">
        @if (State.SessionHistory.Any())
        {
            @foreach (var record in State.SessionHistory.Take(10))
            {
                var subjectDef = State.Subjects.FirstOrDefault(s => s.Name == record.Subject);

                <div class="history-row">
                    <div class="history-left-group">
                        <span class="history-session-type @(record.Mode == TimerMode.Work ? "work" : "break")">
                            @(record.Mode == TimerMode.Work ? "Work" : "Break")
                        </span>
                        <div>
                            <div class="history-task-text">@record.TaskTitle</div>
                            <div class="history-meta-text">
                                @record.CompletedAt.ToString("hh:mm tt") • @record.Subject
                            </div>
                        </div>
                    </div>
                    <div class="history-duration-badge">
                        +@record.DurationMinutes m
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-placeholder">
                No sessions recorded today.
            </div>
        }
    </div>
</div>

@code {
    private int ProgressPercent
    {
        get
        {
            if (State.Settings.DailyPomodoroGoal <= 0) return 0;
            return Math.Min(100, (int)((double)State.CompletedPomodoroCount / State.Settings.DailyPomodoroGoal * 100));
        }
    }

    private async Task ClearHistory()
    {
        await State.ClearHistoryAsync();
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
