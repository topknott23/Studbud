@inject StudyStateService State

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fadeIn" @onclick="Close">
        <div class="w-full max-w-md bg-white dark:bg-[#121520] border border-slate-200 dark:border-[#1E2337] rounded-2xl shadow-2xl p-6 transition-all" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-[#1E2337] mb-5">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                    <h3 class="font-bold text-base text-slate-900 dark:text-white">Preferences & Timer Settings</h3>
                </div>
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#1E2337] transition-all" @onclick="Close">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Settings Fields -->
            <div class="grid grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1.5">Focus Duration (min)</label>
                    <input type="number" class="w-full px-3 py-2 text-sm rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" min="1" max="120" @bind="workMins" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1.5">Short Break (min)</label>
                    <input type="number" class="w-full px-3 py-2 text-sm rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" min="1" max="60" @bind="shortMins" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1.5">Long Break (min)</label>
                    <input type="number" class="w-full px-3 py-2 text-sm rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" min="1" max="60" @bind="longMins" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-[#949BAF] mb-1.5">Daily Goal (cycles)</label>
                    <input type="number" class="w-full px-3 py-2 text-sm rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200 dark:border-[#1E2337] text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" min="1" max="30" @bind="dailyGoal" />
                </div>
            </div>

            <!-- Audio Chime Toggle -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-[#161928] border border-slate-200/80 dark:border-[#1E2337] mb-6">
                <div>
                    <div class="text-xs font-bold text-slate-800 dark:text-white">Chime Sound Notification</div>
                    <div class="text-[11px] text-slate-500 dark:text-[#949BAF]">Play cheerful tone on timer completion</div>
                </div>
                <input type="checkbox" class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 cursor-pointer accent-indigo-600" @bind="soundEnabled" />
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3">
                <button class="px-4 py-2 text-xs font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-[#1E2337] transition-all" @onclick="Close">
                    Cancel
                </button>
                <button class="px-5 py-2 text-xs font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all" @onclick="SaveSettings">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private int workMins;
    private int shortMins;
    private int longMins;
    private int dailyGoal;
    private bool soundEnabled;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            workMins = State.Settings.WorkDurationMinutes;
            shortMins = State.Settings.ShortBreakMinutes;
            longMins = State.Settings.LongBreakMinutes;
            dailyGoal = State.Settings.DailyPomodoroGoal;
            soundEnabled = State.Settings.SoundEnabled;
        }
    }

    private async Task SaveSettings()
    {
        var settings = new UserSettings
        {
            WorkDurationMinutes = Math.Clamp(workMins, 1, 120),
            ShortBreakMinutes = Math.Clamp(shortMins, 1, 60),
            LongBreakMinutes = Math.Clamp(longMins, 1, 60),
            DailyPomodoroGoal = Math.Clamp(dailyGoal, 1, 50),
            SoundEnabled = soundEnabled,
            Theme = State.Settings.Theme
        };

        await State.UpdateSettingsAsync(settings);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
