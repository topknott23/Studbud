@inject StudyStateService State

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header-clean">
                <span class="modal-title-clean">Preferences</span>
                <button class="btn-close-clean" @onclick="Close">✕</button>
            </div>

            <div class="settings-fields-grid">
                <div class="field-group">
                    <label class="field-label">Focus (minutes)</label>
                    <input type="number" class="field-input" min="1" max="120" @bind="workMins" />
                </div>
                <div class="field-group">
                    <label class="field-label">Short Break (minutes)</label>
                    <input type="number" class="field-input" min="1" max="60" @bind="shortMins" />
                </div>
                <div class="field-group">
                    <label class="field-label">Long Break (minutes)</label>
                    <input type="number" class="field-input" min="1" max="60" @bind="longMins" />
                </div>
                <div class="field-group">
                    <label class="field-label">Daily Goal (cycles)</label>
                    <input type="number" class="field-input" min="1" max="30" @bind="dailyGoal" />
                </div>
            </div>

            <div style="border-top: 1px solid var(--border-subtle); padding-top: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 0.85rem; font-weight: 500; color: var(--text-primary);">Audio Chime</div>
                    <div style="font-size: 0.75rem; color: var(--text-tertiary);">Play chime on interval completion</div>
                </div>
                <input type="checkbox" style="width: 16px; height: 16px; cursor: pointer; accent-color: var(--text-primary);" @bind="soundEnabled" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
                <button class="btn-minimal" @onclick="Close">Cancel</button>
                <button class="btn-solid-primary" style="padding: 0.45rem 1.15rem; font-size: 0.8rem;" @onclick="SaveSettings">
                    Save
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private int workMins;
    private int shortMins;
    private int longMins;
    private int dailyGoal;
    private bool soundEnabled;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            workMins = State.Settings.WorkDurationMinutes;
            shortMins = State.Settings.ShortBreakMinutes;
            longMins = State.Settings.LongBreakMinutes;
            dailyGoal = State.Settings.DailyPomodoroGoal;
            soundEnabled = State.Settings.SoundEnabled;
        }
    }

    private async Task SaveSettings()
    {
        var settings = new UserSettings
        {
            WorkDurationMinutes = Math.Clamp(workMins, 1, 120),
            ShortBreakMinutes = Math.Clamp(shortMins, 1, 60),
            LongBreakMinutes = Math.Clamp(longMins, 1, 60),
            DailyPomodoroGoal = Math.Clamp(dailyGoal, 1, 50),
            SoundEnabled = soundEnabled,
            Theme = State.Settings.Theme
        };

        await State.UpdateSettingsAsync(settings);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
