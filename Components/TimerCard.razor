@inject StudyStateService State
@implements IDisposable

<div class="minimal-card">
    <div class="minimal-card-header">
        <span class="minimal-card-title">Timer</span>
        <span class="history-session-type @(State.CurrentMode == TimerMode.Work ? "work" : "break")">
            @(State.CurrentMode switch {
                TimerMode.Work => "Focus Session",
                TimerMode.ShortBreak => "Short Break",
                TimerMode.LongBreak => "Long Break",
                _ => "Focus"
            })
        </span>
    </div>

    <div class="timer-container">
        <!-- Segmented Control Tabs -->
        <div class="segmented-control">
            <button class="segmented-btn @(State.CurrentMode == TimerMode.Work ? "active" : "")" 
                    @onclick="() => State.SetMode(TimerMode.Work)">
                Focus (@State.Settings.WorkDurationMinutes m)
            </button>
            <button class="segmented-btn @(State.CurrentMode == TimerMode.ShortBreak ? "active" : "")" 
                    @onclick="() => State.SetMode(TimerMode.ShortBreak)">
                Short Break (@State.Settings.ShortBreakMinutes m)
            </button>
            <button class="segmented-btn @(State.CurrentMode == TimerMode.LongBreak ? "active" : "")" 
                    @onclick="() => State.SetMode(TimerMode.LongBreak)">
                Long Break (@State.Settings.LongBreakMinutes m)
            </button>
        </div>

        <!-- Sleek Arc Timer Frame -->
        <div class="timer-display-frame">
            <svg class="timer-svg" viewBox="0 0 230 230">
                <circle class="timer-track-circle" cx="115" cy="115" r="98" />
                <circle class="timer-progress-arc @GetProgressColorClass()"
                        cx="115" cy="115" r="98"
                        stroke-dasharray="@Circumference"
                        stroke-dashoffset="@CalculateDashOffset()" />
            </svg>

            <div class="timer-digits-wrapper">
                <div class="timer-digits">@FormattedTime</div>
                @if (ActiveTask != null)
                {
                    <div class="timer-task-chip" title="@ActiveTask.Title">
                        @ActiveTask.Title
                    </div>
                }
                else
                {
                    <div class="timer-status-caption">Ready to focus</div>
                }
            </div>
        </div>

        <!-- Action Controls -->
        <div class="timer-actions">
            <button class="btn-ghost-icon" @onclick="() => State.ResetTimer()" title="Reset Timer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                    <path d="M3 3v5h5"/>
                </svg>
            </button>

            @if (!State.IsRunning)
            {
                <button class="btn-solid-primary" @onclick="() => State.StartTimer()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                    <span>Start Focus</span>
                </button>
            }
            else
            {
                <button class="btn-solid-primary" style="background: var(--status-warning); color: #000;" @onclick="() => State.PauseTimer()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="4" width="4" height="16"/>
                        <rect x="14" y="4" width="4" height="16"/>
                    </svg>
                    <span>Pause</span>
                </button>
            }

            <button class="btn-ghost-icon" @onclick="() => State.SkipTimer()" title="Skip Session">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 4 15 12 5 20 5 4"/>
                    <line x1="19" y1="5" x2="19" y2="19"/>
                </svg>
            </button>
        </div>

        <!-- Cycle Progress Indicator -->
        <div class="cycle-dots-row">
            <span class="cycle-dots-label">Daily Target (@State.CompletedPomodoroCount / @State.Settings.DailyPomodoroGoal cycles)</span>
            <div class="cycle-pills">
                @for (int i = 0; i < State.Settings.DailyPomodoroGoal; i++)
                {
                    <div class="cycle-pill @(i < State.CompletedPomodoroCount ? "filled" : "")"></div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const double Radius = 98;
    private double Circumference => 2 * Math.PI * Radius;

    private TaskItem? ActiveTask => State.Tasks.FirstOrDefault(t => t.Id == State.ActiveTaskId);

    private string FormattedTime
    {
        get
        {
            int mins = State.RemainingSeconds / 60;
            int secs = State.RemainingSeconds % 60;
            return $"{mins:D2}:{secs:D2}";
        }
    }

    private string GetProgressColorClass() => State.CurrentMode switch
    {
        TimerMode.Work => "mode-work",
        TimerMode.ShortBreak => "mode-short",
        TimerMode.LongBreak => "mode-long",
        _ => "mode-work"
    };

    private double CalculateDashOffset()
    {
        if (State.TotalModeSeconds <= 0) return 0;
        double progressRatio = (double)State.RemainingSeconds / State.TotalModeSeconds;
        return Circumference * (1.0 - progressRatio);
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
