@inject StudyStateService State
@implements IDisposable

@if (State.IsAlarmRinging)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md animate-fadeIn" 
         tabindex="0" 
         @onkeydown="HandleKeyDown">
        
        <!-- Glowing animated background halo -->
        <div class="absolute w-96 h-96 rounded-full @(State.AlarmTriggeredMode == TimerMode.Work ? "bg-indigo-500/20 blur-3xl animate-pulse" : "bg-emerald-500/20 blur-3xl animate-pulse") pointer-events-none"></div>

        <!-- Alarm Dialog Container -->
        <div class="relative w-full max-w-lg bg-white dark:bg-[#121520] border-2 @(State.AlarmTriggeredMode == TimerMode.Work ? "border-indigo-500/50 shadow-indigo-500/20" : "border-emerald-500/50 shadow-emerald-500/20") rounded-3xl shadow-2xl p-6 sm:p-8 overflow-hidden text-center transition-all animate-bounce-subtle">
            
            <!-- Top Audio Status Strip -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide @(State.AlarmTriggeredMode == TimerMode.Work ? "bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/60" : "bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60") mb-4">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                </span>
                <span>Alarm Ringing on Loop</span>
                <!-- Equalizer visualizer bars -->
                <div class="flex items-end gap-0.5 h-3 ml-1">
                    <span class="w-1 bg-current rounded-full animate-pulse h-2"></span>
                    <span class="w-1 bg-current rounded-full animate-pulse h-3" style="animation-delay: 150ms;"></span>
                    <span class="w-1 bg-current rounded-full animate-pulse h-1.5" style="animation-delay: 300ms;"></span>
                    <span class="w-1 bg-current rounded-full animate-pulse h-2.5" style="animation-delay: 450ms;"></span>
                </div>
            </div>

            <!-- Big Ringing Icon / Ring Animation -->
            <div class="relative flex items-center justify-center my-4">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl @(State.AlarmTriggeredMode == TimerMode.Work ? "bg-gradient-to-tr from-indigo-600 to-violet-500 shadow-lg shadow-indigo-500/30" : "bg-gradient-to-tr from-emerald-600 to-teal-500 shadow-lg shadow-emerald-500/30") flex items-center justify-center text-white ring-8 @(State.AlarmTriggeredMode == TimerMode.Work ? "ring-indigo-100 dark:ring-indigo-950/50" : "ring-emerald-100 dark:ring-emerald-950/50") animate-wiggle">
                    <svg class="w-12 h-12 sm:w-14 sm:h-14 drop-shadow-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        <path d="M2 8c0-2.2 1.8-4 4-4"/>
                        <path d="M22 8c0-2.2-1.8-4-4-4"/>
                    </svg>
                </div>
            </div>

            <!-- Title & Subtitle -->
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white mt-4">
                @(State.AlarmTriggeredMode == TimerMode.Work ? "Focus Session Completed!" : "Break Time Is Up!")
            </h2>

            <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 max-w-sm mx-auto leading-relaxed">
                @(State.AlarmTriggeredMode == TimerMode.Work 
                    ? "Great work on staying focused! You can stop the alarm to take your scheduled break, or extend by 5 more minutes to wrap up." 
                    : "Your break session has finished. Stop the alarm to start your next focus session or snooze for 5 more minutes.")
            </p>

            <!-- Ringtone info badge -->
            <div class="mt-4 py-1.5 px-3 rounded-xl bg-slate-100 dark:bg-[#181C2B] text-slate-500 dark:text-[#949BAF] text-xs font-mono inline-flex items-center gap-1.5 border border-slate-200/80 dark:border-[#1E2337]">
                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"/>
                    <circle cx="6" cy="18" r="3"/>
                    <circle cx="18" cy="16" r="3"/>
                </svg>
                <span>Playing alarm sound continuously...</span>
            </div>

            <!-- Primary Action Buttons -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-6 sm:mt-8">
                <!-- 5 Mins More / Snooze Button -->
                <button @onclick="ExtendFiveMinutes" 
                        class="order-2 sm:order-1 px-5 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 group cursor-pointer">
                    <svg class="w-5 h-5 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>+5 Mins More</span>
                </button>

                <!-- Stop Alarm Button -->
                <button @onclick="StopAlarm" 
                        class="order-1 sm:order-2 px-5 py-3.5 rounded-2xl @(State.AlarmTriggeredMode == TimerMode.Work ? "bg-indigo-600 hover:bg-indigo-700 shadow-indigo-600/30" : "bg-emerald-600 hover:bg-emerald-700 shadow-emerald-600/30") text-white font-bold text-sm shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="6" width="12" height="12" rx="2"/>
                    </svg>
                    <span>Stop Alarm</span>
                </button>
            </div>

            <!-- Keyboard shortcut hint -->
            <div class="mt-4 text-[11px] text-slate-400 dark:text-slate-500 font-mono">
                Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-[#1E2337] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300">Space</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-[#1E2337] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300">Enter</kbd> to stop • <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-[#1E2337] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300">5</kbd> for +5 mins
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task StopAlarm()
    {
        await State.StopAlarmAsync();
    }

    private async Task ExtendFiveMinutes()
    {
        await State.ExtendTimerAsync(5);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!State.IsAlarmRinging) return;

        if (e.Key is " " or "Enter" or "Escape")
        {
            await StopAlarm();
        }
        else if (e.Key is "5" or "s" or "S")
        {
            await ExtendFiveMinutes();
        }
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
