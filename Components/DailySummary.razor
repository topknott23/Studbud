@inject StudyStateService State
@implements IDisposable

<div class="stats-banner">
    <!-- Metric 1: Focus Cycles -->
    <div class="stat-tile">
        <div class="stat-tile-header">
            <span class="stat-tile-label">Cycles</span>
            <span style="font-size: 0.75rem; color: var(--text-tertiary);">Daily Goal</span>
        </div>
        <div class="stat-tile-value">
            @State.CompletedPomodoroCount <span style="font-size: 1.1rem; color: var(--text-tertiary); font-weight: 400;">/ @State.Settings.DailyPomodoroGoal</span>
        </div>
        <div class="stat-tile-sub">
            @DailyGoalPercentage% completed
        </div>
    </div>

    <!-- Metric 2: Total Study Time -->
    <div class="stat-tile">
        <div class="stat-tile-header">
            <span class="stat-tile-label">Focus Time</span>
            <span style="font-size: 0.75rem; color: var(--text-tertiary);">Today</span>
        </div>
        <div class="stat-tile-value">
            @FormattedStudyTime
        </div>
        <div class="stat-tile-sub">
            @TodaySessionsCount sessions
        </div>
    </div>

    <!-- Metric 3: Tasks Completed -->
    <div class="stat-tile">
        <div class="stat-tile-header">
            <span class="stat-tile-label">Tasks</span>
            <span style="font-size: 0.75rem; color: var(--text-tertiary);">Pending: @(State.Tasks.Count - CompletedTasksCount)</span>
        </div>
        <div class="stat-tile-value">
            @CompletedTasksCount <span style="font-size: 1.1rem; color: var(--text-tertiary); font-weight: 400;">/ @State.Tasks.Count</span>
        </div>
        <div class="stat-tile-sub">
            @(State.Tasks.Count > 0 ? (int)((double)CompletedTasksCount / State.Tasks.Count * 100) : 0)% task completion
        </div>
    </div>

    <!-- Metric 4: Productivity Rate -->
    <div class="stat-tile">
        <div class="stat-tile-header">
            <span class="stat-tile-label">Productivity</span>
            <span style="font-size: 0.75rem; color: var(--status-success);">Active</span>
        </div>
        <div class="stat-tile-value">
            @(Math.Min(100, (int)(DailyGoalPercentage * 1.25)))%
        </div>
        <div class="stat-tile-sub">
            Daily focus score
        </div>
    </div>
</div>

@code {
    private int TodaySessionsCount => State.SessionHistory.Count(s => s.Mode == TimerMode.Work && s.CompletedAt.Date == DateTime.Today);
    private int TodayTotalMinutes => State.SessionHistory.Where(s => s.Mode == TimerMode.Work && s.CompletedAt.Date == DateTime.Today).Sum(s => s.DurationMinutes);

    private int CompletedTasksCount => State.Tasks.Count(t => t.IsCompleted);

    private int DailyGoalPercentage
    {
        get
        {
            if (State.Settings.DailyPomodoroGoal <= 0) return 0;
            return Math.Min(100, (int)((double)State.CompletedPomodoroCount / State.Settings.DailyPomodoroGoal * 100));
        }
    }

    private string FormattedStudyTime
    {
        get
        {
            int hours = TodayTotalMinutes / 60;
            int mins = TodayTotalMinutes % 60;
            if (hours > 0)
            {
                return $"{hours}h {mins}m";
            }
            return $"{mins}m";
        }
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
